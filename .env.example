# =============================================================================
# DeepfakeGuard environment variables
# =============================================================================
# Copy to .env for local use. The frontend (Vite) only reads VITE_* prefixed
# vars at build time; the backend reads its own vars from the shell.
# Vercel serves these via its project settings, not this file.

# --- Frontend (Vite) ---------------------------------------------------------
# Not currently required: the frontend calls the relative "/api/detect" path,
# which Vercel rewrites to the ngrok backend (see vercel.json). No CORS and no
# hardcoded host means the same bundle works on Vercel, Netlify and localhost.

# --- ngrok (local tunnel to the backend on your laptop) ----------------------
# Preferred: keep the token in .ngrok.authtoken.yml (gitignored).
# Or export it instead of using that file:
#   NGROK_AUTHTOKEN=<your-token-from-ngrok-dashboard>
NGROK_AUTHTOKEN=""

# --- Backend (backend/main.py) ----------------------------------------------
# Comma-separated list of origins allowed by CORS. Only needed if the frontend
# talks to the ngrok host directly (e.g. a browser WebSocket). When Vercel
# rewrites /api/* the request is same-origin, so this is usually unnecessary.
# Defaults already include localhost:3000, localhost:5173 and the ngrok domain.
#   CORS_ORIGINS="https://your-app.vercel.app,https://unguided-anymore-size.ngrok-free.dev"
CORS_ORIGINS=""

# Master switch for the Multi-Stage Gated Pipeline (1 = on, 0 = bypass).
# Set to 0 to fall back to the pre-gate behaviour for debugging.
DEEPFAKE_GATE_ENABLED="1"

# Optional: HuggingFace token, required ONLY by Gate 2's overlapping-speaker
# check (pyannote). Without it that sub-check is skipped, never fatal.
HF_TOKEN=""

# --- AI Studio (legacy, injected automatically) ------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
